print("====== Cálculo da Média da Turma ======" )

quantidade = int(input("Digite a quantidade de alunos da turma: "))
soma_media = 0

for i in range(1, quantidade +1):
    media = float(input(f"Digite a média do {i}° aluno: "))
    soma_media += media

media_turma = soma_media/quantidade

print("\n===== RESULTADO =======")
print(f"Quantidade de Alunos: {quantidade}")
print(f"Média da Turma: {media_turma:.2f}")
print("Cálculo concluído com sucesso")
